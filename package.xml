<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/menu" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/menu" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="navigation.website-menus">
                <title>Website menus</title>
                <description>
                    Renders responsive website navigation with mega, dropdown, sidebar, slide-out, tab, URL-list, one-page, and submenu variants.
                </description>
            </capability>

            <capability id="navigation.independent-menu-management">
                <title>Independent menu management</title>
                <description>
                    Creates and manages multilingual hierarchical menus independently of the site tree through the backend, REST API, and MCP tools.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/menu/bin/images/Logo.jpg"/>

        <support>
            <email><![CDATA[info@quiqqer.com]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/menu]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/menu/-/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/menu/-/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[PCSG QL-1.0]]></license>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <provider>
            <rest src="\QUI\Menu\Rest\Provider"/>
            <mcp src="\QUI\Menu\MCP\Provider"/>
        </provider>
    </package>
</quiqqer>
